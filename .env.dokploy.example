# Variables para Dokploy (Compose → Environment). Los valores CAMBIAR_* son secretos propios.
APP_NAME="ECORTESCL CRM"
APP_ENV=production
APP_KEY=CAMBIAR_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://crm.ecortes.cl
ASSET_URL=https://crm.ecortes.cl
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

DB_DATABASE=ecortes_crm
DB_USERNAME=ecortes
DB_PASSWORD=CAMBIAR_password_db
DB_ROOT_PASSWORD=CAMBIAR_password_root_db

# Administrador inicial (se crea solo la primera vez, con el CRM vacío)
ADMIN_NAME="Administrador ECORTESCL"
ADMIN_EMAIL=admin@ecortes.cl
ADMIN_PASSWORD=CAMBIAR_password_admin

# true = carga una vez datos de muestra (1 cliente + propuestas por origen)
SEED_DEMO=false
