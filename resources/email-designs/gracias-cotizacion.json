{
  "slug": "gracias-cotizacion",
  "name": "Recibimos tu solicitud de cotización",
  "description": "Confirmación al solicitar una cotización o reunión: pronto se confirmará y contactará al solicitante.",
  "category": "transactional",
  "subject": "Recibimos tu solicitud de cotización",
  "preheader": "Pronto te confirmaremos y contactaremos",
  "variables": [
    {
      "key": "first_name",
      "label": "Nombre",
      "default": "",
      "sample": "María"
    },
    {
      "key": "site_url",
      "label": "Sitio web",
      "default": "https://www.ecortes.cl",
      "sample": "https://www.ecortes.cl"
    },
    {
      "key": "tipo_servicio",
      "label": "Servicio de interés",
      "default": "",
      "sample": "Sitio web"
    },
    {
      "key": "fecha_preferida",
      "label": "Fecha preferida",
      "default": "",
      "sample": "15-10-2026"
    }
  ],
  "design": {
    "settings": {
      "bg": "#F4F4F4",
      "contentBg": "#FFFFFF",
      "width": 600,
      "font": "Arial, Helvetica, sans-serif",
      "textColor": "#393939",
      "linkColor": "#2563EB",
      "radius": 16
    },
    "blocks": [
      {
        "id": "b000000n",
        "type": "header",
        "props": {
          "logoUrl": "{{LOGO_URL}}",
          "logoWidth": 150,
          "brandText": "ECORTESCL",
          "brandColor": "#2563EB",
          "align": "center",
          "padY": 28,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000o",
        "type": "heading",
        "props": {
          "text": "Gracias por tu solicitud, {{ first_name }}",
          "size": 26,
          "color": "#393939",
          "weight": "700",
          "align": "left",
          "padY": 12,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000p",
        "type": "text",
        "props": {
          "text": "Recibimos tu solicitud de cotización. **Pronto te estaremos confirmando** y contactando para acelerar el proceso.",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000q",
        "type": "text",
        "props": {
          "text": "{{#if tipo_servicio}}Servicio de interés: **{{ tipo_servicio }}**{{/if}}{{#if fecha_preferida}}\nReunión preferida: **{{ fecha_preferida }}**{{/if}}",
          "size": 15,
          "color": "#707070",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000r",
        "type": "heading",
        "props": {
          "text": "Qué sigue",
          "size": 18,
          "color": "#393939",
          "weight": "700",
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000s",
        "type": "text",
        "props": {
          "text": "**1.** Un ejecutivo de ECORTESCL revisa tu solicitud.\n\n**2.** Te escribimos o llamamos para confirmar la reunión.\n\n**3.** Preparamos una propuesta a la medida de tu proyecto.",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000t",
        "type": "button",
        "props": {
          "label": "Conoce ECORTESCL",
          "href": "{{ site_url }}",
          "bg": "#2563EB",
          "color": "#FFFFFF",
          "radius": 999,
          "size": 16,
          "align": "center",
          "fullWidth": false,
          "padY": 20,
          "padX": 32,
          "rowBg": ""
        }
      },
      {
        "id": "b000000u",
        "type": "footer",
        "props": {
          "company": "{{ company_name }}",
          "address": "{{ADDRESS}}",
          "legal": "Recibes este correo porque tienes una cuenta o solicitud en ECORTESCL.",
          "showUnsubscribe": false,
          "unsubscribeText": "Darme de baja",
          "showView": false,
          "color": "#8A8A8A",
          "align": "center",
          "padY": 24,
          "padX": 32,
          "bg": "#FAFAFA"
        }
      }
    ]
  },
  "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<style>\nbody{margin:0;padding:0;-webkit-text-size-adjust:100%}\nimg{border:0;outline:none;text-decoration:none}\na{color:#2563EB}\n@media only screen and (max-width:620px){.col{display:block!important;max-width:100%!important;width:100%!important;padding:0 0 16px 0!important}.px{padding-left:20px!important;padding-right:20px!important}}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F4F4F4;font-family:Arial, Helvetica, sans-serif;color:#393939\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F4F4F4\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;overflow:hidden\">\n<tr><td class=\"px\" style=\"padding:28px 32px;\"><div style=\"text-align:center\"><img src=\"{{LOGO_URL}}\" width=\"150\" alt=\"ECORTESCL\" style=\"display:inline-block;width:150px;max-width:100%;height:auto;border:0\"></div></td></tr>\n<tr><td class=\"px\" style=\"padding:12px 32px;\"><h1 style=\"margin:0;font-size:26px;line-height:1.25;font-weight:700;color:#393939;text-align:left\">Gracias por tu solicitud, {{ first_name }}</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#393939;text-align:left\">Recibimos tu solicitud de cotización. <strong>Pronto te estaremos confirmando</strong> y contactando para acelerar el proceso.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:15px;line-height:1.6;color:#707070;text-align:left\">{{#if tipo_servicio}}Servicio de interés: <strong>{{ tipo_servicio }}</strong>{{/if}}{{#if fecha_preferida}}<br>Reunión preferida: <strong>{{ fecha_preferida }}</strong>{{/if}}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><h1 style=\"margin:0;font-size:18px;line-height:1.25;font-weight:700;color:#393939;text-align:left\">Qué sigue</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#393939;text-align:left\"><strong>1.</strong> Un ejecutivo de ECORTESCL revisa tu solicitud.<br><br><strong>2.</strong> Te escribimos o llamamos para confirmar la reunión.<br><br><strong>3.</strong> Preparamos una propuesta a la medida de tu proyecto.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:20px 32px;\"><div style=\"text-align:center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"display:inline-table;\"><tr><td align=\"center\" bgcolor=\"#2563EB\" style=\"background-color:#2563EB;border-radius:999px\"><a href=\"{{ site_url }}\" target=\"_blank\" style=\"display:block;padding:14px 28px;font-size:16px;line-height:1.2;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:999px\">Conoce ECORTESCL</a></td></tr></table></div></td></tr>\n<tr><td class=\"px\" style=\"padding:24px 32px;background-color:#FAFAFA;\"><div style=\"font-size:12px;line-height:1.7;color:#8A8A8A;text-align:center\"><strong>{{ company_name }}</strong><br>{{ADDRESS}}<br>Recibes este correo porque tienes una cuenta o solicitud en ECORTESCL.</div></td></tr>\n</table>\n</td></tr></table>\n</body>\n</html>"
}
