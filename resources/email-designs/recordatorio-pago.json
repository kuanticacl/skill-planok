{
  "slug": "recordatorio-pago",
  "name": "Recordatorio de pago",
  "description": "Recordatorio automático (antes, el día y después del vencimiento) o manual de una factura por pagar.",
  "category": "transactional",
  "subject": "{{ subject_line }}",
  "preheader": "{{ headline }}",
  "variables": [
    {
      "key": "first_name",
      "label": "Nombre",
      "default": "",
      "sample": "María"
    },
    {
      "key": "subject_line",
      "label": "Asunto",
      "default": "",
      "sample": "Recordatorio: la factura F-1024 vence pronto"
    },
    {
      "key": "headline",
      "label": "Título",
      "default": "",
      "sample": "Tu factura vence en 5 días"
    },
    {
      "key": "message",
      "label": "Mensaje",
      "default": "",
      "sample": "Te recordamos que la factura F-1024 vence el 15-11-2026."
    },
    {
      "key": "invoice_number",
      "label": "N° de factura",
      "default": "",
      "sample": "F-1024"
    },
    {
      "key": "concept",
      "label": "Concepto",
      "default": "",
      "sample": "Mantención web · octubre 2026"
    },
    {
      "key": "total",
      "label": "Total a pagar",
      "default": "",
      "sample": "$119.000"
    },
    {
      "key": "due_date",
      "label": "Vencimiento",
      "default": "",
      "sample": "15-11-2026"
    },
    {
      "key": "payment_link",
      "label": "Enlace de pago",
      "default": "",
      "sample": ""
    },
    {
      "key": "portal_url",
      "label": "Enlace al portal",
      "default": "https://clientes.ecortes.cl/portal/facturas",
      "sample": "https://clientes.ecortes.cl/portal/facturas"
    }
  ],
  "design": {
    "settings": {
      "bg": "#F4F4F4",
      "contentBg": "#FFFFFF",
      "width": 600,
      "font": "Arial, Helvetica, sans-serif",
      "textColor": "#393939",
      "linkColor": "#15803D",
      "radius": 16
    },
    "blocks": [
      {
        "id": "b000000n",
        "type": "header",
        "props": {
          "logoUrl": "{{LOGO_URL}}",
          "logoWidth": 150,
          "brandText": "ECORTESCL",
          "brandColor": "#3DBB6C",
          "align": "center",
          "padY": 28,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000o",
        "type": "heading",
        "props": {
          "text": "{{ headline }}",
          "size": 26,
          "color": "#393939",
          "weight": "700",
          "align": "left",
          "padY": 12,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000p",
        "type": "text",
        "props": {
          "text": "Hola {{ first_name }}, {{ message }}",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 8,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000q",
        "type": "text",
        "props": {
          "text": "Factura\n**{{ invoice_number }}** · {{ concept }}\n\nTotal a pagar\n**{{ total }}**\n\nVencimiento\n**{{ due_date }}**",
          "size": 16,
          "color": "",
          "lineHeight": 1.6,
          "align": "left",
          "padY": 16,
          "padX": 32,
          "bg": "#FAFAFA"
        }
      },
      {
        "id": "b000000r",
        "type": "button",
        "props": {
          "label": "Ver y pagar mi factura",
          "href": "{{ portal_url }}",
          "bg": "#64D989",
          "color": "#0B1220",
          "radius": 999,
          "size": 16,
          "align": "center",
          "fullWidth": false,
          "padY": 20,
          "padX": 32,
          "rowBg": ""
        }
      },
      {
        "id": "b000000s",
        "type": "text",
        "props": {
          "text": "{{#if payment_link}}Enlace de pago directo: {{ payment_link }}{{/if}}",
          "size": 14,
          "color": "#707070",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 4,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000t",
        "type": "text",
        "props": {
          "text": "Si ya realizaste el pago, avísanos respondiendo este correo para actualizar tu estado.",
          "size": 13,
          "color": "#8A8A8A",
          "lineHeight": 1.6,
          "align": "center",
          "padY": 6,
          "padX": 32,
          "bg": ""
        }
      },
      {
        "id": "b000000u",
        "type": "footer",
        "props": {
          "company": "{{ company_name }}",
          "address": "{{ADDRESS}}",
          "legal": "Recibes este correo porque tienes una cuenta o solicitud en ECORTESCL.",
          "showUnsubscribe": false,
          "unsubscribeText": "Darme de baja",
          "showView": false,
          "color": "#8A8A8A",
          "align": "center",
          "padY": 24,
          "padX": 32,
          "bg": "#FAFAFA"
        }
      }
    ]
  },
  "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<style>\nbody{margin:0;padding:0;-webkit-text-size-adjust:100%}\nimg{border:0;outline:none;text-decoration:none}\na{color:#15803D}\n@media only screen and (max-width:620px){.col{display:block!important;max-width:100%!important;width:100%!important;padding:0 0 16px 0!important}.px{padding-left:20px!important;padding-right:20px!important}}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F4F4F4;font-family:Arial, Helvetica, sans-serif;color:#393939\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F4F4F4\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;overflow:hidden\">\n<tr><td class=\"px\" style=\"padding:28px 32px;\"><div style=\"text-align:center\"><img src=\"{{LOGO_URL}}\" width=\"150\" alt=\"ECORTESCL\" style=\"display:inline-block;width:150px;max-width:100%;height:auto;border:0\"></div></td></tr>\n<tr><td class=\"px\" style=\"padding:12px 32px;\"><h1 style=\"margin:0;font-size:26px;line-height:1.25;font-weight:700;color:#393939;text-align:left\">{{ headline }}</h1></td></tr>\n<tr><td class=\"px\" style=\"padding:8px 32px;\"><div style=\"font-size:16px;line-height:1.6;color:#393939;text-align:left\">Hola {{ first_name }}, {{ message }}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:16px 32px;background-color:#FAFAFA;\"><div style=\"font-size:16px;line-height:1.6;color:#393939;text-align:left\">Factura<br><strong>{{ invoice_number }}</strong> · {{ concept }}<br><br>Total a pagar<br><strong>{{ total }}</strong><br><br>Vencimiento<br><strong>{{ due_date }}</strong></div></td></tr>\n<tr><td class=\"px\" style=\"padding:20px 32px;\"><div style=\"text-align:center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"display:inline-table;\"><tr><td align=\"center\" bgcolor=\"#64D989\" style=\"background-color:#64D989;border-radius:999px\"><a href=\"{{ portal_url }}\" target=\"_blank\" style=\"display:block;padding:14px 28px;font-size:16px;line-height:1.2;font-weight:600;color:#0B1220;text-decoration:none;border-radius:999px\">Ver y pagar mi factura</a></td></tr></table></div></td></tr>\n<tr><td class=\"px\" style=\"padding:4px 32px;\"><div style=\"font-size:14px;line-height:1.6;color:#707070;text-align:center\">{{#if payment_link}}Enlace de pago directo: {{ payment_link }}{{/if}}</div></td></tr>\n<tr><td class=\"px\" style=\"padding:6px 32px;\"><div style=\"font-size:13px;line-height:1.6;color:#8A8A8A;text-align:center\">Si ya realizaste el pago, avísanos respondiendo este correo para actualizar tu estado.</div></td></tr>\n<tr><td class=\"px\" style=\"padding:24px 32px;background-color:#FAFAFA;\"><div style=\"font-size:12px;line-height:1.7;color:#8A8A8A;text-align:center\"><strong>{{ company_name }}</strong><br>{{ADDRESS}}<br>Recibes este correo porque tienes una cuenta o solicitud en ECORTESCL.</div></td></tr>\n</table>\n</td></tr></table>\n</body>\n</html>"
}
